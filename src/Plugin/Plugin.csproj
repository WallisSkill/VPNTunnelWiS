<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Library</OutputType>
    <RootNamespace>FortiVpnPlugin</RootNamespace>
    <AssemblyName>FortiVpnPlugin</AssemblyName>
    <UseUwp>true</UseUwp>
    <!-- Emits FortiVpnPlugin.winmd so the VPN platform can activate FortiPlugin
         as a WinRT class via WinRT.Host.dll. -->
    <CsWinRTComponent>true</CsWinRTComponent>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The hostfxr bridge in Exports.cs hands out raw ABI pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>

</Project>
