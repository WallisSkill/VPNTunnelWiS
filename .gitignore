# Build output
bin/
obj/

# What build-native.cmd writes: the .obj/.dll/.exe cl.exe produces. build.ps1 copies
# them into dist\, so nothing outside this folder needs them.
src/Native/build/

# Same for the installer, and this one also holds payload.zip -- the whole of dist\
# compressed, regenerated by installer.ps1 on every run.
src/Installer/build/

# The package layout is a generated artifact: ~250 MB of the .NET runtime that
# would otherwise dominate every diff. layout/ is the old name, kept ignored so a
# stale copy from an earlier checkout never shows up as untracked.
dist/
layout/
out/
*.msix
*.appx

# Signing material. The .cer is the public dev certificate and is kept, but a
# private key must never be committed.
*.pfx
*.snk
